# SuperApple ERP — production .env template.
# Copy to the project root as `.env`, fill the placeholders, then generate the
# key with `php artisan key:generate`. NEVER commit the real .env or any secret.

# ---- Application ----
APP_NAME="SuperApple ERP"
APP_ENV=production
APP_DEBUG=false
APP_KEY=                      # generate on the server: php artisan key:generate
APP_URL=https://<your-domain>
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
# Storage timezone stays UTC unless the business explicitly decides otherwise
# (changing it shifts attendance/billing/payroll date boundaries):
# APP_TIMEZONE=UTC
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Do NOT set this in production — it would allow demo data to be seeded:
# APP_ALLOW_DEMO_SEED=false

# ---- Database (MySQL 8) ----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=superapple
DB_USERNAME=superapple
DB_PASSWORD=                  # a strong password — never commit it

# ---- Cache / Session / Queue (all database-backed by default) ----
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true    # HTTPS only
QUEUE_CONNECTION=database
QUEUE_FAILED_DRIVER=database-uuids

# ---- Filesystem ----
FILESYSTEM_DISK=local         # attachments live under storage/app (private)

# ---- Logging ----
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning             # production: warning or error, not debug

# ---- Mail (optional — the app does not depend on outgoing mail) ----
MAIL_MAILER=log

# ---- WhatsApp ----
# The channel ships DISABLED with the Null provider; the app runs fine without it.
# Enable a real provider only when going live with WhatsApp (see docs/deploy/whatsapp-golive.md).
# Provider tokens belong in env / secure config — never in code or the database dump:
# WHATSAPP_PHONE_NUMBER_ID=<your-phone-number-id>
# WHATSAPP_TOKEN=<your-permanent-access-token>
